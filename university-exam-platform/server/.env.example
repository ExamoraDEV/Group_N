# Required backend settings. Keep real values in the ignored .env file.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/examora?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173

# Role-convention checks. Update these patterns to match official university email formats.
STUDENT_EMAIL_REGEX=^22STD[A-Z0-9._-]+@university\.edu$
LECTURER_EMAIL_REGEX=^LEC[A-Z0-9._-]+@university\.edu$

# Bootstrap the single authorized Admin with: npm run seed:admin
# Keep the real password only in server/.env; never commit it.
ADMIN_EMAIL=ADMIN001@university.edu
ADMIN_PASSWORD=
ADMIN_NAME=Examora Administrator
